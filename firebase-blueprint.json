        "systemAction": { "type": "string", "maxLength": 32 },
        "systemTargetName": { "type": "string", "maxLength": 80 },
        "attachmentUrl": { "type": "string", "maxLength": 2048 },
        "attachmentName": { "type": "string", "maxLength": 256 },
        "attachmentType": { "type": "string", "maxLength": 128 },
        "replyToId": { "type": "string", "maxLength": 128 },
